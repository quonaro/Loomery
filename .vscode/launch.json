{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Loomery: Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--disable-workspace-trust",
        "--profile=Loomery Extension Dev",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--enable-proposed-api=quonaro.loomery",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/extension/**/*.js"],
      "preLaunchTask": "watch"
    }
  ]
}
